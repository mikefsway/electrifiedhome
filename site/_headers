# Cloudflare Pages response headers. The Content-Security-Policy is
# deliberately strict, like many embedders' sites: it allows the KarbonKit
# loader script and its iframes and nothing else from outside. If a KarbonKit
# change ever needs more than this, it will break here before it breaks on a
# council's website.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://widgets.karbonkit.com; frame-src https://widgets.karbonkit.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=86400
